{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/The-Mhood/TDD/Tools/canon/data/canon_index.schema.json",
  "title": "TDD Canon Index",
  "description": "Engineering mirror of the authoritative Drive Art Bible registers. Validated by Tools/canon/tests.",
  "type": "object",
  "required": ["meta", "approval_states", "chapters", "source_documents", "locations", "memories", "bosses", "chapter_rules"],
  "additionalProperties": false,
  "definitions": {
    "canon_status": {
      "type": "string",
      "enum": ["Proposed", "DesignApproved", "CanonApproved", "Shippable"]
    },
    "approval_triplet": {
      "type": "object",
      "description": "The three INDEPENDENT approval axes required by OAD-47/OAD-48. They must never be collapsed.",
      "required": ["design", "canon", "shippable"],
      "additionalProperties": false,
      "properties": {
        "design": { "type": "boolean" },
        "canon": { "type": "boolean" },
        "shippable": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["document", "version", "generated", "authority", "id_scheme"],
      "properties": {
        "document": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "authority": { "type": "string" },
        "authority_note": { "type": "string" },
        "id_scheme": {
          "type": "object",
          "required": ["chapter", "scene", "sublocation", "interior", "boss"],
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "approval_states": { "type": "array", "items": { "$ref": "#/definitions/canon_status" }, "minItems": 4 },
    "chapters": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "index", "name", "boss", "canon_status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CH0[1-8]$" },
          "index": { "type": "integer", "minimum": 1, "maximum": 8 },
          "name": { "type": "string", "minLength": 1 },
          "boss": { "type": "string", "minLength": 1 },
          "canon_status": { "$ref": "#/definitions/canon_status" }
        }
      }
    },
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "drive_id", "version", "authority"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "drive_id": { "type": "string", "minLength": 10 },
          "version": { "type": "string" },
          "authority": { "type": "string" }
        }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "chapter", "name", "canon_status", "approval", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CH0[1-8]-(SCN|SUB|INT)-\\d{3}$" },
          "chapter": { "type": "string", "pattern": "^CH0[1-8]$" },
          "name": { "type": "string", "minLength": 1 },
          "canon_status": { "$ref": "#/definitions/canon_status" },
          "approval": { "$ref": "#/definitions/approval_triplet" },
          "source": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "memories": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["index", "chapter", "scene_id", "location_id", "title", "content_status", "establishes", "fragments"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 1, "maximum": 7 },
          "chapter": { "type": "string", "pattern": "^CH0[1-7]$" },
          "scene_id": { "type": "string", "pattern": "^CH0[1-7]-SCN-\\d{3}$" },
          "location_id": { "type": "string", "pattern": "^CH0[1-7]-(SCN|SUB|INT)-\\d{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "content_status": { "$ref": "#/definitions/canon_status" },
          "establishes": { "type": "string", "minLength": 1 },
          "fragments": {
            "type": "object",
            "required": ["place", "object", "sound", "interaction"],
            "additionalProperties": false,
            "properties": {
              "place": { "type": "string", "minLength": 1 },
              "object": { "type": "string", "minLength": 1 },
              "sound": { "type": "string", "minLength": 1 },
              "interaction": { "type": "string", "minLength": 1 }
            }
          },
          "visual_identity": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    },
    "bosses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chapter", "name", "canon_status", "arena_design_status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^CH0[1-8]-BOSS-[A-Z][A-Za-z0-9]*$" },
          "chapter": { "type": "string", "pattern": "^CH0[1-8]$" },
          "name": { "type": "string", "minLength": 1 },
          "canon_status": { "$ref": "#/definitions/canon_status" },
          "arena_design_status": { "type": "string", "enum": ["Proposed", "DesignApproved", "CanonApproved"] },
          "source": { "type": "string" }
        }
      }
    },
    "chapter_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statement", "kind", "source", "enforced_by"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RULE-[A-Z0-9-]+$" },
          "chapter": { "type": ["string", "null"], "pattern": "^CH0[1-8]$" },
          "statement": { "type": "string", "minLength": 10 },
          "kind": {
            "type": "string",
            "enum": ["spawn_exclusion", "asset_exclusion", "asset_identity", "vista_visibility",
                     "material_rule", "material_response", "encounter_exclusion", "character_identity", "cultural"]
          },
          "excludes": { "type": "array", "items": { "type": "string" } },
          "requires_review": { "type": "string", "enum": ["cultural", "art", "technical"] },
          "source": { "type": "string", "minLength": 1 },
          "enforced_by": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
