  "chapter_rules": [
    {
      "id": "RULE-CH01-GREAT-TREE",
      "chapter": "CH01",
      "statement": "The lone giant tree on the horizon is the Great Root Mother's territory and must be visible from every major clearing.",
      "kind": "vista_visibility",
      "source": "ENVIRONMENT_DESIGN_REGISTER; OAD-11",
      "enforced_by": "L2 per-scene visibility automation test"
    },
    {
      "id": "RULE-CH01-SILK-COTTON",
      "chapter": "CH01",
      "statement": "The great tree is a living silk-cotton (kapok) with full crown and plank buttresses; the approach V003 board governs the model.",
      "kind": "asset_identity",
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "art review"
    },
    {
      "id": "RULE-CH02-NO-FLAME",
      "chapter": "CH02",
      "statement": "No living flame anywhere in the kingdom until the boss; the kingdom is cold. Light only from roof cracks.",
      "kind": "asset_exclusion",
      "excludes": [
        "fire_vfx",
        "torch_lit",
        "brazier_lit"
      ],
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "L0 chapter manifest validation + art review"
    },
    {
      "id": "RULE-CH03-NO-REMAINS",
      "chapter": "CH03",
      "statement": "No remains are ever shown. Objects are put down, not thrown. Faces in the palace are scraped away.",
      "kind": "asset_exclusion",
      "excludes": [
        "skeletal_remains",
        "corpse",
        "bones_human"
      ],
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "L0 chapter manifest validation + art review"
    },
    {
      "id": "RULE-CH03-ASH-NOT-SNOW",
      "chapter": "CH03",
      "statement": "Ash must not read as snow.",
      "kind": "material_response",
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "art review under 3 lighting setups"
    },
    {
      "id": "RULE-CH04-PYTHONS",
      "chapter": "CH04",
      "statement": "Pythons are never enemies and never loot in Idemili's domain. They may appear as ambient wildlife and signs of her presence. Royal python markings only.",
      "kind": "spawn_exclusion",
      "excludes": [
        "enemy:snake",
        "loot:snake",
        "enemy:python"
      ],
      "source": "OAD-14; ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "L0 spawn table validation + L2 runtime spawn assertion"
    },
    {
      "id": "RULE-CH04-NO-LIGHTNING",
      "chapter": "CH04",
      "statement": "No lightning in Chapter 4; it is kept for Amadioha.",
      "kind": "asset_exclusion",
      "excludes": [
        "lightning_vfx"
      ],
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "L0 chapter manifest validation"
    },
    {
      "id": "RULE-CH04-NO-STILTS",
      "chapter": "CH04",
      "statement": "Houses stand on the ground in the same building tradition as elsewhere, never on stilts.",
      "kind": "asset_exclusion",
      "excludes": [
        "stilt_house"
      ],
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "L0 chapter manifest validation + art review"
    },
    {
      "id": "RULE-CH04-SHRINE-NO-COMBAT",
      "chapter": "CH04",
      "statement": "No combat at the shrine. Idemili's presence is shown by water, chalk, white cloth and the python, never by an image or a face.",
      "kind": "encounter_exclusion",
      "excludes": [
        "combat:CH04-SUB-002"
      ],
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "L0 encounter validation + L2 runtime assertion"
    },
    {
      "id": "RULE-CH05-WHITE-LIGHTNING",
      "chapter": "CH05",
      "statement": "Lightning is white only, never coloured. Nothing is built on the mountain; people only cut rock or drive iron into it.",
      "kind": "asset_identity",
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "art review"
    },
    {
      "id": "RULE-CH05-NO-ALPINE",
      "chapter": "CH05",
      "statement": "A West African granite dome, never an alpine peak: no snow, no conifers. The storm never leaves the summit and the summit is visible in every board.",
      "kind": "asset_exclusion",
      "excludes": [
        "snow",
        "conifer",
        "alpine_peak"
      ],
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "L0 chapter manifest validation"
    },
    {
      "id": "RULE-CH06-MASK-INVENTED",
      "chapter": "CH06",
      "statement": "All face coverings are invented and featureless: a smooth oval with two eye slits at most. No horns, paint, raffia, crests or any feature of a real masquerade. Needs consultant review before further development.",
      "kind": "asset_identity",
      "requires_review": "cultural",
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "asset validation + cultural review gate"
    },
    {
      "id": "RULE-CH06-BLANK-VARIANTS",
      "chapter": "CH06",
      "statement": "Face coverings must not drift to round discs or forms with a nose ridge. Nothing is monstrous; the place is wrong only in small ways.",
      "kind": "asset_identity",
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "asset validation"
    },
    {
      "id": "RULE-CH07-EARTH-NOT-STONE",
      "chapter": "CH07",
      "statement": "The stronghold of the dead is earth, timber and cloth burnt hard like fired clay, never a stone castle. Ember red only deep in cracks, never flame. Grey burial cloth, no ferryman, no figures, no remains. Sky starless.",
      "kind": "asset_exclusion",
      "excludes": [
        "fire_vfx",
        "stone_castle_kit",
        "human_remains",
        "ferryman"
      ],
      "source": "ENVIRONMENT_DESIGN_REGISTER",
      "enforced_by": "L0 chapter manifest validation + art review"
    },
    {
      "id": "RULE-NPC-CHILDREN-NO-COMBAT",
      "chapter": null,
      "statement": "Children appear only in the home settlement and are never combat targets.",
      "kind": "spawn_exclusion",
      "excludes": [
        "combat_target:child",
        "enemy:child"
      ],
      "source": "SCENE_AND_MICROLOCATION_MASTER_REGISTER#CH01-SCN-001 production notes",
      "enforced_by": "targeting validation + L2 runtime assertion"
    },
    {
      "id": "RULE-OKWU-HOOD",
      "chapter": null,
      "statement": "Okwu's hood shows darkness only, in every light, always. No face, no stone.",
      "kind": "material_rule",
      "source": "OAD-12",
      "enforced_by": "3-rig lighting validation test"
    },
    {
      "id": "RULE-ADANNA-NO-MIRROR",
      "chapter": null,
      "statement": "Adanna's features are never mirrored or moved. Left: cheekbone scar, three bronze braid cuffs + two coral beads at temple, single shoulder guard, coiled armlet, blade at hip. Right side plain.",
      "kind": "character_identity",
      "source": "CHARACTER_DESIGN_REGISTER; OAD-51",
      "enforced_by": "character validation test (sockets, no mirrored mesh)"
    },
    {
      "id": "RULE-ADANNA-ONE-WEAPON",
      "chapter": null,
      "statement": "Adanna carries exactly one weapon: a short leaf-bladed iron sword about 60 cm, worn on the left hip. No spear, no second weapon, no wrist bracelets.",
      "kind": "character_identity",
      "source": "CHARACTER_DESIGN_REGISTER; OAD-09, OAD-37",
      "enforced_by": "inventory data validation + character validation test"
    },
    {
      "id": "RULE-CULTURAL-FICTIONALITY",
      "chapter": null,
      "statement": "Invented mythology must never be presented as authentic Igbo tradition. Depictions of Amadioha, Idemili and the land of the dead are fiction and must be labelled as such in codex and credits.",
      "kind": "cultural",
      "source": "Directive#1; OAD-05, OAD-04",
      "enforced_by": "codex data validation (bFictionalMythology flag) + credits review"
    }
  ]
}
