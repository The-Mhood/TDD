# ============================================================================
# THE DISOBEDIENT DAUGHTER — line endings and binary handling
# See Docs/adr/ADR-0004-binary-asset-storage.md
# ============================================================================

* text=auto eol=lf

# --- Text: normalise, and do not let git pretend it can merge generated data ---
*.cpp   text eol=lf
*.h     text eol=lf
*.cs    text eol=lf
*.ini   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.csv   text eol=lf

# --- Python: diffs readable ---
*.py    diff=python

# --- Unreal BINARIES: never diff, never merge. NOT tracked in plain git. ---
# If a binary unexpectedly lands in the repo, these rules make the mistake
# obvious in review rather than silently corrupting data.
*.uasset  binary -merge -diff
*.umap    binary -merge -diff
*.ubulk   binary -merge -diff
*.uexp    binary -merge -diff
*.upk     binary -merge -diff
*.pak     binary -merge -diff
*.utoc    binary -merge -diff
*.ucas    binary -merge -diff
*.wav     binary -merge -diff
*.mp3     binary -merge -diff
*.ogg     binary -merge -diff
*.png     binary -merge -diff
*.jpg     binary -merge -diff
*.jpeg    binary -merge -diff
*.tga     binary -merge -diff
*.exr     binary -merge -diff
*.fbx     binary -merge -diff
*.obj     binary -merge -diff
*.usd     binary -merge -diff
*.usda    binary -merge -diff

